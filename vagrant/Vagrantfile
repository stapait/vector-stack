# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# VM local (VirtualBox) para testar ansible/vector-provision.yml contra uma
# imagem o mais próxima possível de Amazon Linux 2023 — complementar ao
# docker/local-ec2 (container), agora numa VM de verdade (kernel próprio,
# systemd como PID 1 sem nenhum truque de container). Ver README.md nesta
# pasta para detalhes e "por que bento/amazonlinux-2023".

Vagrant.configure("2") do |config|
  # Nome fixo da máquina (não "default") para o caminho da chave privada
  # gerada por `vagrant up` ficar previsível:
  # .vagrant/machines/vector/virtualbox/private_key — usado no inventário
  # ../ansible/inventory/vagrant.ini.
  config.vm.define "vector"

  config.vm.box = "bento/amazonlinux-2023"
  config.vm.hostname = "vector-concentrador"
  config.vm.box_check_update = false

  # Não precisamos de pasta compartilhada nesta etapa (nem depois, quando
  # as apps NestJS forem rodar no host — a comunicação será por rede, não
  # por filesystem compartilhado) — desabilita para não depender de
  # VirtualBox Guest Additions bater com o kernel da box.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # IP fixo simplifica o inventário do Ansible (vagrant/../ansible/inventory/vagrant.ini)
  # e a chave privada gerada por `vagrant up` fica em caminho previsível
  # (.vagrant/machines/vector/virtualbox/private_key).
  config.vm.network "private_network", ip: "192.168.56.20"

  config.vm.provider "virtualbox" do |vb|
    vb.name = "vector-concentrador"
    vb.memory = 1024
    vb.cpus = 1
  end

  # Disco extra, simulando o volume EBS que numa EC2 real já chega montado
  # em /mnt/vector antes do Ansible rodar (ver AWS.md, seção 3 — "o Ansible
  # não mexe no volume EBS"). Igual ao volume Docker nomeado usado em
  # docker/local-ec2, só que aqui é um disco de verdade formatado dentro da
  # VM, mais fiel a um EBS real que um bind/shared folder.
  config.vm.disk :disk, size: "3GB", name: "vector-data"

  # Formata (na primeira vez) e monta o disco extra em /mnt/vector — parte
  # do "provisionamento de infraestrutura" que fica fora do Ansible, exatamente
  # como aconteceria numa EC2 real (quem sobe a instância já entrega o EBS
  # montado). Roda antes do Ansible entrar em ação.
  config.vm.provision "mount-vector-volume", type: "shell", path: "provision/mount-vector-volume.sh"
end
