#!/bin/bash
# Gerado pelo Ansible (vector-provision.yml) — não editar manualmente.
#
# Mesma lógica do textfile-collector do ambiente Docker
# (docker/concentrador/textfile-collector/log-metrics.sh): calcula, por app,
# tamanho em disco e timestamp do log mais recente, escrevendo métricas
# custom lidas pelo node_exporter (--collector.textfile.directory). Como
# escaneia o diretório dinamicamente, uma app nova aparece nas métricas
# sozinha, sem precisar reconfigurar nada aqui.
set -euo pipefail

LOG_ROOT="{{ vector_data_root }}/logs"
OUT_DIR="{{ textfile_collector_dir }}"
FINAL_FILE="$OUT_DIR/log_app_metrics.prom"
TMP_FILE="$(mktemp "$OUT_DIR/.log_app_metrics.XXXXXX")"

{
  echo "# HELP log_app_disk_bytes Espaco em disco ocupado pela aplicacao em $LOG_ROOT"
  echo "# TYPE log_app_disk_bytes gauge"
  if [ -d "$LOG_ROOT" ]; then
    for app_dir in "$LOG_ROOT"/*/; do
      [ -d "$app_dir" ] || continue
      app="$(basename "$app_dir")"
      size="$(du -sb "$app_dir" 2>/dev/null | cut -f1)"
      echo "log_app_disk_bytes{app=\"$app\"} ${size:-0}"
    done
  fi

  echo "# HELP log_app_last_write_timestamp_seconds Timestamp do ultimo log recebido da aplicacao"
  echo "# TYPE log_app_last_write_timestamp_seconds gauge"
  if [ -d "$LOG_ROOT" ]; then
    for app_dir in "$LOG_ROOT"/*/; do
      [ -d "$app_dir" ] || continue
      app="$(basename "$app_dir")"
      last="$(find "$app_dir" -type f -printf '%T@\n' 2>/dev/null | sort -rn | head -1)"
      last="${last%%.*}"
      echo "log_app_last_write_timestamp_seconds{app=\"$app\"} ${last:-0}"
    done
  fi
} > "$TMP_FILE"

chmod 644 "$TMP_FILE"
mv "$TMP_FILE" "$FINAL_FILE"
